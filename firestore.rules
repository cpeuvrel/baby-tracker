rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isHouseholdMember(householdId) {
      return request.auth != null &&
        request.auth.uid in
          get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    match /households/{householdId} {
      allow read, update, delete: if isHouseholdMember(householdId);
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.memberUids;

      match /babies/{babyId} {
        allow read, write: if isHouseholdMember(householdId);

        match /{entryCollection}/{entryId} {
          allow read, write: if isHouseholdMember(householdId);
        }
      }
    }

    match /users/{uid}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
