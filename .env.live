# "live" mode: `npm run dev:live`.
#
# Reproduces the prod setup locally — no emulators, so the real Google
# signInWithPopup (iframe + postMessage to <project>.firebaseapp.com)
# and real Firestore, exactly the code path that runs in production.
#
# Project keys still come from .env.local; this file only forces the flag,
# and .env.<mode> takes priority over .env.local on Vite's side.
#
# WARNING: in this mode, writes go to the REAL data.
VITE_USE_FIREBASE_EMULATORS=false
