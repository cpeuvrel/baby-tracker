# Mode "live" : `npm run dev:live`.
#
# Reproduit le setup de prod en local — pas d'émulateurs, donc le vrai
# signInWithPopup Google (iframe + postMessage vers <projet>.firebaseapp.com)
# et le vrai Firestore, exactement le code path qui tourne en production.
#
# Les clés du projet viennent toujours de .env.local ; ce fichier ne fait que
# forcer le flag, et .env.<mode> est prioritaire sur .env.local côté Vite.
#
# ATTENTION : dans ce mode, les écritures partent sur les VRAIES données.
VITE_USE_FIREBASE_EMULATORS=false
